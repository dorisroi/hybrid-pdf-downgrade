    given-names: "Thị Thúy"
    affiliation: "Thang Long University"
  - family-names: "Lê"
    given-names: "Phê Đô"
    affiliation: "Thang Long University"
  - family-names: "Nguyễn"
    given-names: "Thị Trà My"
    affiliation: "Thang Long University"
license: Apache-2.0
keywords:
  - post-quantum cryptography
  - hybrid signatures
  - non-separability
  - PDF
  - PAdES
  - downgrade attack
